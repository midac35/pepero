<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>지독한 놈의 빼빼로 만들기</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts (Gaegu / Noto Sans KR) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Noto+Sans+KR:wght@400;600;800&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Noto Sans KR', sans-serif;
      background-color: #f72585;
      background-image: radial-gradient(#ff70a6 10%, transparent 11%), radial-gradient(#ff70a6 10%, transparent 11%);
      background-size: 30px 30px;
      background-position: 0 0, 15px 15px;
    }

    .font-gaegu {
      font-family: 'Gaegu', cursive;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #ffe5ec;
      border-radius: 10px;
    }
    ::-webkit-scrollbar-thumb {
      background: #ff4d6d;
      border-radius: 10px;
    }

    /* Canvas styling */
    #peperoCanvas {
      touch-action: none;
      cursor: crosshair;
    }

    /* Cute Button Press Effect */
    .btn-bounce {
      transition: all 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .btn-bounce:hover {
      transform: translateY(-2px) scale(1.02);
    }
    .btn-bounce:active {
      transform: translateY(1px) scale(0.98);
    }

    .active-tool {
      border-color: #ff0054 !important;
      background-color: #ffb703 !important;
      color: #000 !important;
      box-shadow: 0 0 12px rgba(255, 183, 3, 0.8);
    }

    .color-swatch.active {
      transform: scale(1.25);
      outline: 3px solid #000;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

    .sprinkle-swatch.active {
      transform: scale(1.15);
      border-color: #ff0054;
      background-color: #ffe5ec;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start p-2 md:p-6 text-gray-800">

  <!-- Header -->
  <header class="w-full max-w-2xl text-center my-3">
    <div class="inline-block bg-white/95 px-5 py-3 rounded-full shadow-lg border-4 border-red-500">
      <h1 class="text-base sm:text-2xl md:text-3xl font-black text-red-600 tracking-wider flex items-center justify-center gap-1.5 whitespace-nowrap" style="font-family: 'Noto Sans KR', sans-serif; font-weight: 900;">
        <span>🔥</span> 지독한 놈의 빼빼로 만들기 <span>🍫</span>
      </h1>
    </div>
  </header>

  <!-- Ordered Layout Container (1 ~ 5 Order) -->
  <main class="w-full max-w-xl flex flex-col items-center gap-5 my-auto pb-8">

    <!-- 1. 내 빼빼로 이미지 (Pepero Canvas Area) -->
    <section class="w-full flex flex-col items-center">
      <div class="w-full text-left mb-1.5 px-2">
        <span class="bg-red-500 text-white font-bold text-xs px-2.5 py-1 rounded-full shadow">1단계</span>
        <span class="font-extrabold text-gray-800 text-lg ml-1 font-gaegu">내 빼빼로 이미지</span>
      </div>
      <div class="bg-white p-3 rounded-3xl shadow-2xl border-4 border-red-400 relative w-full flex justify-center">
        <canvas id="peperoCanvas" width="380" height="480" class="rounded-2xl border-2 border-pink-100 bg-pink-50 max-w-full h-auto"></canvas>
        <!-- Floating Canvas Helper Tag -->
        <div class="absolute bottom-5 right-5 bg-white/95 backdrop-blur px-3 py-1 rounded-full text-xs font-bold text-pink-600 shadow border border-pink-200 pointer-events-none">
          ✨ 초코 부분에 자유롭게 꾸며보세요!
        </div>
      </div>
    </section>

    <!-- 2. 빼빼로 종류 선택 (Type Selection) -->
    <section class="w-full bg-white/90 backdrop-blur-md p-4 rounded-3xl shadow-xl border-4 border-pink-300">
      <div class="w-full text-left mb-3">
        <span class="bg-pink-500 text-white font-bold text-xs px-2.5 py-1 rounded-full shadow">2단계</span>
        <span class="font-extrabold text-gray-800 text-lg ml-1 font-gaegu">빼빼로 종류 선택</span>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5" id="typeContainer">
        <!-- Dynamic JS Insertion -->
      </div>
    </section>

    <!-- 3. 꾸미기 도구 선택 (Decoration Tools Selection) -->
    <section class="w-full bg-white/90 backdrop-blur-md p-4 rounded-3xl shadow-xl border-4 border-pink-300 flex flex-col gap-4">
      <div class="w-full text-left border-b-2 border-pink-200 pb-2">
        <span class="bg-purple-500 text-white font-bold text-xs px-2.5 py-1 rounded-full shadow">3단계</span>
        <span class="font-extrabold text-gray-800 text-lg ml-1 font-gaegu">꾸미기 도구 선택</span>
      </div>

      <!-- Tool Switch (Pen vs Sprinkle) -->
      <div class="grid grid-cols-2 gap-3">
        <button id="toolPen" class="tool-btn active-tool btn-bounce py-2.5 px-4 rounded-2xl border-2 border-gray-300 font-extrabold text-sm flex items-center justify-center gap-2 shadow">
          <i class="fa-solid fa-pen-nib"></i> 초코펜 (Pen)
        </button>
        <button id="toolSprinkle" class="tool-btn btn-bounce bg-gray-100 hover:bg-pink-100 py-2.5 px-4 rounded-2xl border-2 border-gray-300 font-extrabold text-sm flex items-center justify-center gap-2 shadow">
          <i class="fa-solid fa-star"></i> 토핑 뿌리기 (Sprinkles)
        </button>
      </div>

      <!-- Pen Settings (Thickness & Color) -->
      <div id="penControls" class="flex flex-col gap-3">
        <!-- Thickness -->
        <div>
          <label class="text-xs font-extrabold text-gray-600 block mb-1">펜 두께 조절</label>
          <div class="flex items-center gap-2 bg-pink-50 p-2.5 rounded-xl border border-pink-200">
            <i class="fa-solid fa-circle text-xs text-pink-400"></i>
            <input type="range" id="penWidth" min="2" max="25" value="6" class="w-full accent-pink-500 cursor-pointer">
            <i class="fa-solid fa-circle text-lg text-pink-500"></i>
            <span id="widthValue" class="text-xs font-bold text-gray-600 min-w-[30px] text-right">6px</span>
          </div>
        </div>

        <!-- Choco Pen Color Palette -->
        <div>
          <label class="text-xs font-extrabold text-gray-600 block mb-1">초코펜 색상</label>
          <div class="grid grid-cols-4 md:grid-cols-8 gap-2 bg-pink-50 p-3 rounded-xl border border-pink-200 justify-items-center" id="colorPalette">
            <!-- Dynamically Populated Colors -->
          </div>
        </div>
      </div>

      <!-- Sprinkle Options Panel -->
      <div id="sprinkleControls" class="hidden flex flex-col gap-3">
        <label class="text-xs font-extrabold text-gray-600 block mb-1">스프링클 모양 선택</label>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2" id="sprinklePalette">
          <!-- Dynamically Populated Sprinkles -->
        </div>
      </div>
    </section>

    <!-- 4. 되돌리기 / 다시그리기 (Action Buttons) -->
    <section class="w-full bg-white/90 backdrop-blur-md p-4 rounded-3xl shadow-xl border-4 border-pink-300">
      <div class="w-full text-left mb-3">
        <span class="bg-amber-500 text-white font-bold text-xs px-2.5 py-1 rounded-full shadow">4단계</span>
        <span class="font-extrabold text-gray-800 text-lg ml-1 font-gaegu">실수 수정 & 초기화</span>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <button id="btnUndo" class="btn-bounce bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold py-3 px-4 rounded-2xl shadow-md border-2 border-amber-600 flex items-center justify-center gap-2">
          <i class="fa-solid fa-rotate-left"></i> 되돌리기 (Undo)
        </button>
        <button id="btnClear" class="btn-bounce bg-rose-500 hover:bg-rose-600 text-white font-bold py-3 px-4 rounded-2xl shadow-md border-2 border-rose-700 flex items-center justify-center gap-2">
          <i class="fa-solid fa-trash-can"></i> 다시 그리기 (Reset)
        </button>
      </div>
    </section>

    <!-- 5. 내 빼빼로 저장 (Save Button) -->
    <section class="w-full">
      <div class="w-full text-left mb-1.5 px-2">
        <span class="bg-emerald-600 text-white font-bold text-xs px-2.5 py-1 rounded-full shadow">5단계</span>
        <span class="font-extrabold text-gray-800 text-lg ml-1 font-gaegu">완성작 저장</span>
      </div>
      <button id="btnSave" class="w-full btn-bounce bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold py-3.5 px-6 rounded-2xl shadow-xl border-3 border-emerald-700 text-lg flex items-center justify-center gap-2">
        <i class="fa-solid fa-download"></i> 내 빼빼로 저장 📸
      </button>
    </section>

  </main>

  <script>
    // --- PEPERO BASE DATA DEFINITION (4 Types with Chunky Big-Pie Specs) ---
    const PEPERO_TYPES = [
      {
        id: 'classic',
        name: '클래식 초코',
        stickColor: '#E29555',
        chocoColor: '#3E2723',
        isNude: false,
        desc: '진한 오리지널'
      },
      {
        id: 'white_choco',
        name: '화이트 초코',
        stickColor: '#E8A76C',
        chocoColor: '#FFFDD0',
        crumbs: false,
        isNude: false,
        desc: '부드러운 화이트 초코'
      },
      {
        id: 'strawberry',
        name: '딸기 상큼',
        stickColor: '#E29555',
        chocoColor: '#FF85A1',
        isNude: false,
        desc: '상큼핑키 딸기 초코'
      },
      {
        id: 'nude',
        name: '누드 빼빼로',
        stickColor: '#F4C47A',
        chocoColor: '#2C1810',
        isNude: true,
        desc: '속에 초코 든 파이 스틱'
      }
    ];

    // --- COLOR PALETTE DEFINITION ---
    const PEN_COLORS = [
      { name: '밀크 화이트', code: '#FFFFFF' },
      { name: '다크 초코', code: '#2D1500' },
      { name: '딸기 핑크', code: '#FF4D6D' },
      { name: '바나나 옐로우', code: '#FFD166' },
      { name: '민트 그린', code: '#06D6A0' },
      { name: '소다 블루', code: '#118AB2' },
      { name: '보라 캔디', code: '#9D4EDD' },
      { name: '네온 핑크', code: '#FF007F' }
    ];

    // --- SPRINKLES DEFINITION ---
    const SPRINKLES = [
      { id: 'heart', name: '하트 💗', shape: 'heart', color: '#FF3366' },
      { id: 'star', name: '별 ⭐', shape: 'star', color: '#FFD700' },
      { id: 'round_sugar', name: '동그라미 ⭕', shape: 'circle', colors: ['#FF9AA2', '#FFB7B2', '#FFDAC1', '#E2F0CB', '#B5EAD7', '#C7CEEA'] },
      { id: 'long_stick', name: '긴 모양 🥖', shape: 'long_stick', colors: ['#FF4D6D', '#FFD166', '#06D6A0', '#118AB2', '#FFFFFF', '#9D4EDD'] }
    ];

    // --- STATE MANAGEMENT ---
    let currentBase = PEPERO_TYPES[0];
    let currentMode = 'pen';
    let currentPenColor = PEN_COLORS[0].code;
    let currentPenWidth = 6;
    let currentSprinkle = SPRINKLES[0];

    let isDrawing = false;
    let history = [];
    let currentStroke = null;

    // --- DOM ELEMENTS ---
    const canvas = document.getElementById('peperoCanvas');
    const ctx = canvas.getContext('2d');
    const typeContainer = document.getElementById('typeContainer');
    const colorPalette = document.getElementById('colorPalette');
    const sprinklePalette = document.getElementById('sprinklePalette');
    const penWidthInput = document.getElementById('penWidth');
    const widthValueDisplay = document.getElementById('widthValue');
    const toolPenBtn = document.getElementById('toolPen');
    const toolSprinkleBtn = document.getElementById('toolSprinkle');
    const penControls = document.getElementById('penControls');
    const sprinkleControls = document.getElementById('sprinkleControls');
    const btnUndo = document.getElementById('btnUndo');
    const btnClear = document.getElementById('btnClear');
    const btnSave = document.getElementById('btnSave');

    // --- INITIALIZATION ---
    window.onload = () => {
      renderBaseButtons();
      renderColorPalette();
      renderSprinklePalette();
      setupEventListeners();
      redrawCanvas();
      saveState();
    };

    // --- RENDER UI CONTROLS ---
    function renderBaseButtons() {
      typeContainer.innerHTML = '';
      PEPERO_TYPES.forEach((type) => {
        const btn = document.createElement('button');
        btn.className = `btn-bounce w-full text-center p-2.5 rounded-2xl border-2 flex flex-col items-center justify-center transition-all ${
          currentBase.id === type.id ? 'border-red-500 bg-red-50 font-bold shadow-md ring-2 ring-red-300' : 'border-gray-200 bg-white hover:bg-pink-50'
        }`;
        btn.onclick = () => {
          currentBase = type;
          renderBaseButtons();
          redrawCanvas();
          saveState();
        };

        const pillHtml = `<div class="w-6 h-6 rounded-full border border-gray-300 shadow-inner mt-1" style="background:${type.chocoColor}"></div>`;
        btn.innerHTML = `
          <div class="text-xs font-extrabold text-gray-800">${type.name}</div>
          ${pillHtml}
        `;
        typeContainer.appendChild(btn);
      });
    }

    function renderColorPalette() {
      colorPalette.innerHTML = '';
      PEN_COLORS.forEach((col) => {
        const swatch = document.createElement('button');
        swatch.className = `color-swatch w-8 h-8 rounded-full border-2 border-white shadow-md btn-bounce transition-all ${
          currentPenColor === col.code ? 'active' : ''
        }`;
        swatch.style.backgroundColor = col.code;
        swatch.title = col.name;
        swatch.onclick = () => {
          currentPenColor = col.code;
          renderColorPalette();
        };
        colorPalette.appendChild(swatch);
      });
    }

    function renderSprinklePalette() {
      sprinklePalette.innerHTML = '';
      SPRINKLES.forEach((sp) => {
        const btn = document.createElement('button');
        btn.className = `sprinkle-swatch btn-bounce p-2.5 rounded-xl border-2 text-xs font-bold flex items-center justify-center gap-1 transition-all ${
          currentSprinkle.id === sp.id ? 'active' : 'border-gray-200 bg-white'
        }`;
        btn.innerHTML = `<span>${sp.name}</span>`;
        btn.onclick = () => {
          currentSprinkle = sp;
          renderSprinklePalette();
        };
        sprinklePalette.appendChild(btn);
      });
    }

    // --- CANVAS DRAWING ROUTINES ---
    function redrawCanvas() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawCanvasBackground();
      drawPeperoBase(currentBase);
      drawHistory();
    }

    function drawCanvasBackground() {
      ctx.save();
      ctx.fillStyle = '#FFF5F7';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Plate shadow
      ctx.beginPath();
      ctx.ellipse(canvas.width / 2, canvas.height - 30, 110, 22, 0, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(230, 200, 210, 0.5)';
      ctx.fill();
      ctx.restore();
    }

    function drawPeperoBase(type) {
      ctx.save();

      const centerX = canvas.width / 2;
      const topY = 40;
      const bottomY = canvas.height - 45;
      
      // All sticks are uniform Chunky/Big-Pie stick proportions as requested
      const width = 115;
      const stickHeight = bottomY - topY;
      const radius = 25;

      if (type.isNude) {
        // Nude Pepero: Full Biscuit Body + Dark Choco Top Core Hole & Ends
        ctx.fillStyle = type.stickColor;
        drawRoundedRect(ctx, centerX - width/2, topY, width, stickHeight, radius);
        ctx.fill();

        // Top Chocolate Filled Hole/Rim
        ctx.fillStyle = type.chocoColor;
        ctx.beginPath();
        ctx.ellipse(centerX, topY + 22, width/2 - 14, 12, 0, 0, Math.PI * 2);
        ctx.fill();

        // Biscuit Bottom Feet
        ctx.fillStyle = '#D9823B';
        ctx.fillRect(centerX - 35, bottomY - 15, 15, 15);
        ctx.fillRect(centerX + 20, bottomY - 15, 15, 15);

        // Cute Character Face
        drawCharacterFace(centerX, topY + 95);

      } else {
        // Coated Pepero (Classic, White Cookie, Strawberry)
        const chocoHeight = stickHeight * 0.74;

        // Biscuit Bottom
        ctx.fillStyle = type.stickColor;
        drawRoundedRect(ctx, centerX - width/2, topY, width, stickHeight, radius);
        ctx.fill();

        // Biscuit Feet Details
        ctx.fillStyle = '#C87B3B';
        ctx.fillRect(centerX - 35, bottomY - 15, 15, 15);
        ctx.fillRect(centerX + 20, bottomY - 15, 15, 15);

        // Choco Layer (Top part)
        ctx.fillStyle = type.chocoColor;
        drawTopRoundedRect(ctx, centerX - width/2, topY, width, chocoHeight, radius);
        ctx.fill();

        // Cute Character Face
        drawCharacterFace(centerX, topY + 85);
      }

      ctx.restore();
    }

    // Helper: Draw Cute Face on Pepero
    function drawCharacterFace(cx, cy) {
      ctx.save();
      
      const eyeOffset = 24;
      [cx - eyeOffset, cx + eyeOffset].forEach(ex => {
        // White Outer Eye
        ctx.beginPath();
        ctx.arc(ex, cy, 12, 0, Math.PI * 2);
        ctx.fillStyle = '#FFFFFF';
        ctx.fill();
        
        // Black Inner Pupil
        ctx.beginPath();
        ctx.arc(ex, cy, 6.5, 0, Math.PI * 2);
        ctx.fillStyle = '#1A1A1A';
        ctx.fill();

        // Highlight Spec
        ctx.beginPath();
        ctx.arc(ex - 2, cy - 2, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = '#FFFFFF';
        ctx.fill();
      });

      // Cute Smile
      ctx.beginPath();
      ctx.arc(cx, cy + 11, 7.5, 0.1 * Math.PI, 0.9 * Math.PI, false);
      ctx.lineWidth = 2.8;
      ctx.strokeStyle = '#FFFFFF';
      ctx.stroke();

      // Rosy Cheeks
      ctx.fillStyle = 'rgba(255, 105, 180, 0.45)';
      ctx.beginPath();
      ctx.arc(cx - eyeOffset - 6, cy + 11, 5.5, 0, Math.PI * 2);
      ctx.arc(cx + eyeOffset + 6, cy + 11, 5.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    function drawCookieCrumbs(x, y, w, h, color) {
      ctx.fillStyle = color;
      // Fixed cute chunky cookie positions instead of dense dots
      const cookiePositions = [
        { rx: 0.2, ry: 0.15, r: 7 },
        { rx: 0.75, ry: 0.22, r: 9 },
        { rx: 0.4, ry: 0.35, r: 6 },
        { rx: 0.82, ry: 0.48, r: 8 },
        { rx: 0.25, ry: 0.6, r: 10 },
        { rx: 0.68, ry: 0.7, r: 7 },
        { rx: 0.35, ry: 0.85, r: 8 },
        { rx: 0.15, ry: 0.4, r: 5 },
        { rx: 0.88, ry: 0.88, r: 6 }
      ];

      cookiePositions.forEach(cp => {
        const cx = x + cp.rx * w;
        const cy = y + cp.ry * h;
        
        ctx.beginPath();
        // Draw soft rounded irregular cookie chunks
        ctx.arc(cx, cy, cp.r, 0, Math.PI * 2);
        ctx.fill();

        // Subtle cookie accent/highlight
        ctx.fillStyle = '#2D1500';
        ctx.beginPath();
        ctx.arc(cx - 1.5, cy - 1.5, cp.r * 0.4, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = color;
      });
    }

    // Helper Shapes
    function drawRoundedRect(ctx, x, y, width, height, radius) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + width - radius, y);
      ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
      ctx.lineTo(x + width, y + height - radius);
      ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
      ctx.lineTo(x + radius, y + height);
      ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();
    }

    function drawTopRoundedRect(ctx, x, y, width, height, radius) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + width - radius, y);
      ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
      ctx.lineTo(x + width, y + height - 10);
      ctx.quadraticCurveTo(x + width/2, y + height + 16, x, y + height - 10);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();
    }

    // --- SPRINKLE SHAPE DRAWING HELPERS ---
    function drawSprinkleItem(ctx, sprinkle) {
      ctx.save();
      ctx.translate(sprinkle.x, sprinkle.y);
      if (sprinkle.angle) ctx.rotate(sprinkle.angle);

      if (sprinkle.shape === 'heart') {
        ctx.fillStyle = sprinkle.color;
        ctx.beginPath();
        const size = 10;
        ctx.moveTo(0, -size/4);
        ctx.bezierCurveTo(-size/2, -size, -size, -size/3, 0, size);
        ctx.bezierCurveTo(size, -size/3, size/2, -size, 0, -size/4);
        ctx.fill();

      } else if (sprinkle.shape === 'star') {
        ctx.fillStyle = sprinkle.color;
        drawStar(ctx, 0, 0, 5, 10, 4);
        ctx.fill();

      } else if (sprinkle.shape === 'circle') {
        ctx.fillStyle = sprinkle.color;
        ctx.beginPath();
        ctx.arc(0, 0, 5, 0, Math.PI * 2);
        ctx.fill();

      } else if (sprinkle.shape === 'long_stick') {
        // Long basic sprinkle stick shape
        ctx.fillStyle = sprinkle.color;
        ctx.beginPath();
        ctx.roundRect(-3, -10, 6, 20, 3);
        ctx.fill();
        ctx.strokeStyle = 'rgba(0,0,0,0.1)';
        ctx.lineWidth = 0.5;
        ctx.stroke();
      }

      ctx.restore();
    }

    function drawStar(ctx, cx, cy, spikes, outerRadius, innerRadius) {
      let rot = Math.PI / 2 * 3;
      let x = cx;
      let y = cy;
      let step = Math.PI / spikes;

      ctx.beginPath();
      ctx.moveTo(cx, cy - outerRadius);
      for (let i = 0; i < spikes; i++) {
        x = cx + Math.cos(rot) * outerRadius;
        y = cy + Math.sin(rot) * outerRadius;
        ctx.lineTo(x, y);
        rot += step;

        x = cx + Math.cos(rot) * innerRadius;
        y = cy + Math.sin(rot) * innerRadius;
        ctx.lineTo(x, y);
        rot += step;
      }
      ctx.lineTo(cx, cy - outerRadius);
      ctx.closePath();
    }

